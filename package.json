{
  "name": "moox.fr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "patch-package && husky && npm run svg && npm run markdown",
    "dev": "npm run dev:web",
    "dev:web": "vite dev --host",
    "dev:native": "expo start",
    "build": "npm run build:web",
    "build:web": "npm run prepare && vite build",
    "build:native": "expo run:ios",
    "preview": "npx serve dist/client",
    "lint": "npm run lint:web && npm run lint:native",
    "lint:web": "oxlint --type-aware && tsc --noEmit",
    "lint:native": "expo install --check",
    "test": "npm run test:web && npm run test:native",
    "test:web": "npm run lint:web && npm run build:web",
    "test:native": "npm run lint:native && node scripts/check-bundle.mjs",
    "format": "oxfmt",
    "clean": "npm run svg:clean",
    "svg:clean": "rm -rf  src/svgs/components",
    "svg:web": "react-from-svg svgs src/svgs/components --with-native-for-typescript --allow-override-fill",
    "svg": "npm run svg:clean && npm run svg:web",
    "markdown": "markdown-to-json \"content/**/*.md\" public && node scripts/generate-content-indexes.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "a11y": "node scripts/audit-a11y.mjs",
    "audit:ssr-css": "node scripts/audit-ssr-css.mjs",
    "visual": "node scripts/visual-diff.mjs",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.35",
    "@types/react-native-web": "^0.19.0",
    "@types/tinycolor2": "^1.4.6",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "expo": "~57.0.14",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.11",
    "expo-glass-effect": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tinycolor2": "^1.6.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@moox/markdown-to-json": "^1.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "patch-package": "^8.0.0",
    "playwright-core": "^1.61.1",
    "react-from-svg": "^8.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-cjs-interop": "^4.0.3",
    "vite-plugin-react-native-web": "^3.2.0"
  },
  "expo": {
    "install": {
      "exclude": ["typescript"]
    }
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react-native": {
      "react": "$react"
    },
    "react-native-gesture-handler": {
      "react": "$react"
    },
    "react-native-safe-area-context": {
      "react": "$react"
    },
    "react-native-web": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
